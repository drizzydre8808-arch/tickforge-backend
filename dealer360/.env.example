# Copy to .env and fill in. Never commit .env.
DEALER360_API_KEY=change-me          # app sends this as X-API-Key; set the same in app Settings
DEALER360_DETECTOR=classical         # auto|classical|yolo|vlm (classical is a placeholder)
DVLA_API_KEY=                        # DVLA Vehicle Enquiry Service key
# ANTHROPIC_API_KEY=                 # only for vlm mode (images leave your server)
# DEALER360_YOLO_WEIGHTS=/data/best.pt
